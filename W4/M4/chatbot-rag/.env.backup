# ── LLM (OpenRouter) ────────────────────────────────────────────────────────
## Provider/model identifier — browse https://openrouter.ai/models?output_modalities=text
MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free


## Obtain from https://openrouter.ai/workspaces/default/keys
OPENROUTER_API_KEY=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


# ── Vector store (ChromaDB) ──────────────────────────────────────────────────
## Local directory where ChromaDB persists its data
CHROMA_PATH=./chroma_db

## Name of the collection inside ChromaDB
CHROMA_COLLECTION=documents


# ── Embeddings ───────────────────────────────────────────────────────────────
## "huggingface" (default, local, free) or "openai"
EMBEDDING_PROVIDER=huggingface

## HuggingFace default — fast, lightweight, runs on CPU
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

## Only required when EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=


# ── Frontends ────────────────────────────────────────────────────────────────
## Necessary only for the Telegram frontend
TELEGRAM_BOT_TOKEN=8470009251:AAGzI-VvGGW6kLaFHjWg7DdU4AiEEvTeE90
